# Налаштування віджетів. Після змін перезапустіть: ~/.config/conky-desk/start.sh

# Погода (Open-Meteo, без API-ключа). ЗМІНІТЬ на своє місто!
# Координати міста: https://www.openstreetmap.org (правий клік -> "Показати адресу")
CITY=Київ
LAT=50.4501
LON=30.5234

# Оцінка споживання: TDP вашого процесора, його споживання в простої
# і орієнтовна потужність "решти" (материнка, диски, вентилятори, RAM).
CPU_TDP_W=65
CPU_IDLE_W=8
BASE_W=35

# Каталог зі знімками резервних копій, якщо не Timeshift (формат папок YYYY-MM-DD_HH-MM-SS).
# Для Timeshift лишайте порожнім.
BACKUP_DIR=
